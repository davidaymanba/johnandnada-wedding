# Supabase (guestbook). Without these the guestbook runs on an in-memory store (fine for local dev only).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, never exposed to the browser
# Self-hosted alternative to Supabase: keep blessings in this JSON file
# GUESTBOOK_FILE=/data/blessings.json
# Any long random string; used to hash visitor IPs for rate limiting
GUESTBOOK_SALT=change-me-to-a-long-random-string
# Long random secret that signs the couple's sign-in cookie for /blessings
GUESTBOOK_ADMIN_KEY=a-long-random-secret
# The password John & Nada type on /blessings to read and delete messages
GUESTBOOK_ADMIN_PASSWORD=choose-a-password
# Public URL of the deployed site (used for OG / share links)
NEXT_PUBLIC_SITE_URL=https://johnandnada.codexai.systems
